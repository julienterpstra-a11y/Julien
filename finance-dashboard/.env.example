# Kopieer naar .env en vul in. Laat leeg wat je niet gebruikt.
PORT=3000
# Publieke URL waarop de app bereikbaar is (voor de redirect na bank-login)
BASE_URL=http://localhost:3000

# Optioneel: wachtwoord voor de dashboard (sterk aanbevolen als je het niet alleen lokaal draait)
DASHBOARD_PASSWORD=

# --- Enable Banking (https://enablebanking.com) — gratis voor eigen rekeningen ---
ENABLE_BANKING_APP_ID=
# Pad naar de private key (.pem) die je bij het registreren van de app kreeg
ENABLE_BANKING_KEY_PATH=./data/enablebanking.pem

# --- GoCardless Bank Account Data (voorheen Nordigen) ---
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
